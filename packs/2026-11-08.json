  "articles": [
    {
      "id": "r20261108-a01",
      "title": "The Yellow Raincoat",
      "level": "Dasar",
      "min": 2,
      "body": [
        "Nadia wanted only one thing for her seventh birthday: a yellow raincoat. Her friends thought it was a strange gift, but Nadia had a plan.",
        "When the rain came on Monday morning, Nadia put on her new raincoat and her red boots. She walked to school slowly and jumped in every puddle on the way. Her uniform stayed dry, and her smile was wide.",
        "At school, the other children watched her from the window. The next day, five children came to school in raincoats of many colors. Nadia’s rainy Monday had started something new."
      ],
      "gloss": {
        "raincoat": "jas hujan",
        "strange": "aneh",
        "plan": "rencana",
        "puddle": "genangan air",
        "boots": "sepatu bot",
        "dry": "kering",
        "wide": "lebar"
      },
      "qs": [
        {
          "q": "What gift did Nadia want?",
          "opts": [
            "A red bicycle",
