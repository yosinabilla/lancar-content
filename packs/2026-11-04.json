  "articles": [
    {
      "id": "r20261104-a01",
      "title": "The Lemon Tree",
      "level": "Dasar",
      "min": 2,
      "body": [
        "When Dara moved to her new house, there was a small lemon tree in the backyard. It looked dry and had no fruit.",
        "Every morning before school, Dara watered the tree. Her father showed her how to cut the dead branches. Her little brother made a small fence around it so the neighbor's chickens would not step on it.",
        "Six months later, the tree was full of yellow lemons. Dara's mother made fresh lemonade, and the family drank it under the tree. Dara was proud. She learned that small daily care can give sweet results."
      ],
      "gloss": {
        "backyard": "halaman belakang",
        "watered": "menyiram",
        "branches": "cabang",
        "fence": "pagar",
        "chickens": "ayam",
        "proud": "bangga",
        "care": "perawatan"
      },
