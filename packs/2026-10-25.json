  "articles": [
    {
      "id": "r20261025-a01",
      "title": "A Trip to the Night Zoo",
      "level": "Dasar",
      "min": 2,
      "body": [
        "Last Friday, Budi's class went on a trip to the night zoo. They left school at four o'clock in the afternoon and arrived just before dark.",
        "At the zoo, the students saw owls, bats, and slow lorises. Their guide, Mr. Dani, used a small red flashlight because bright light can hurt the animals' eyes. Budi's favorite animal was the firefly tree, full of tiny lights.",
        "The students came home at ten o'clock. Budi was sleepy, but before bed he drew a picture of the owls. He wants to be a zoo guide one day."
      ],
      "gloss": {
        "trip": "perjalanan",
        "owls": "burung hantu",
        "bats": "kelelawar",
        "flashlight": "senter",
        "bright": "terang",
        "tiny": "kecil",
        "guide": "pemandu"
      },
