  "articles": [
    {
      "id": "r20261023-a01",
      "title": "Grandpa's Rice Field",
      "level": "Dasar",
      "min": 2,
      "body": [
        "Every school holiday, Andi visits his grandpa in the village. Grandpa has a small rice field near a river. Andi loves the fresh air and the green view there.",
        "This morning, Andi woke up at five and went to the field with Grandpa. They checked the water and pulled out some weeds. Grandpa said the rice will be ready to harvest next month.",
        "After lunch, they sat under a big tree and drank sweet tea. Grandpa told stories about the village long ago. Andi was tired but very happy. He wants to come back for the harvest."
      ],
      "gloss": {
        "village": "desa",
        "rice field": "sawah",
        "river": "sungai",
        "weeds": "rumput liar",
        "harvest": "panen",
