  "articles": [
    {
      "id": "r20261117-a01",
      "title": "The Boy Who Planted Trees",
      "level": "Dasar",
      "min": 2,
      "body": [
        "Andi lives in a small village on a dry hill. Last year, his teacher gave every student three small trees. \"Plant them, water them, and watch them grow,\" she said.",
        "Andi planted his trees behind his house. Every morning before school, he carried water from the well in two old bottles. His little sister helped him pull out the weeds. The sun was hot, and the ground was hard, but Andi did not stop.",
        "One year later, the trees are taller than Andi. Birds sit in their branches, and the family eats lunch in their shade. Next month, Andi's class will plant thirty more trees behind the school."
      ],
      "gloss": {
        "village": "desa",
        "hill": "bukit",
        "well": "sumur",
        "weeds": "rumput liar",
        "ground": "tanah",
        "branches": "cabang",
        "shade": "tempat teduh",
        "grow": "tumbuh"
      },
      "qs": [
