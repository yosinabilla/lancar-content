  "articles": [
    {
      "id": "r20261028-a01",
      "title": "A Rainy Day at Grandpa's",
      "level": "Dasar",
      "min": 2,
      "body": [
        "It was raining all day, so Dito and his little sister could not play outside. They were staying at Grandpa's house in the village.",
        "Grandpa had a great idea. He taught them how to make paper boats. Then they put the boats in a big bowl of water and blew them across with straws. Dito's boat won three times!",
        "Before dinner, Grandpa told them stories about when he was a sailor. The rain was still falling, but Dito did not mind anymore. It was the best rainy day ever."
      ],
      "gloss": {
        "raining": "hujan",
        "staying": "menginap",
        "taught": "mengajari",
        "bowl": "mangkuk besar",
        "blew": "meniup",
        "straws": "sedotan",
        "sailor": "pelaut"
      },
