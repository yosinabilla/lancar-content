  "articles": [
    {
      "id": "r20261112-a01",
      "title": "The Paper Crown",
      "level": "Dasar",
      "min": 2,
      "body": [
        "On Friday, the kindergarten teacher gave every child paper, scissors, and glue. \"Make something for someone you love,\" she said.",
        "Little Dita made a paper crown. She colored it purple and put shiny stars on every point. \"This is for Mama,\" she whispered, \"because Mama is a queen.\"",
        "At home, Mama put on the paper crown and wore it all evening. She wore it while she cooked dinner, and she wore it in the family photo that night. The crown was only paper, but to Mama it was treasure."
      ],
      "gloss": {
        "scissors": "gunting",
        "glue": "lem",
        "crown": "mahkota",
        "shiny": "berkilau",
        "whispered": "berbisik",
        "treasure": "harta karun"
      },
      "qs": [
