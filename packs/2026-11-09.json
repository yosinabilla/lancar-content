  "articles": [
    {
      "id": "r20261109-a01",
      "title": "The School Concert",
      "level": "Dasar",
      "min": 2,
      "body": [
        "Raka could sing beautifully at home. But when his teacher chose him to sing alone at the school concert, his legs started to shake.",
        "\"Practice every day,\" said his best friend, Salsa. So Raka practiced in front of Salsa, then in front of his family, and then in front of his whole class.",
        "On the night of the concert, Raka walked onto the stage. The hall was full of people. He saw Salsa smiling in the first row. He opened his mouth and sang every word perfectly. The applause was loud, but Raka’s smile was louder."
      ],
      "gloss": {
        "alone": "sendiri",
        "shake": "bergetar",
        "stage": "panggung",
        "hall": "aula",
        "row": "baris",
        "perfectly": "dengan sempurna",
        "applause": "tepuk tangan"
      },
