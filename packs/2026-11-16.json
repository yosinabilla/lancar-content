  "articles": [
    {
      "id": "r20261116-a01",
      "title": "Lina and the Lost Kitten",
      "level": "Dasar",
      "min": 2,
      "body": [
        "Lina walked home from school on a wet afternoon. Near the big tree, she heard a small sound: meow, meow. A little kitten sat under a bench. It was wet and cold.",
        "Lina picked it up and put it in her jacket. At home, her mother dried the kitten with a towel. They gave it warm milk in a small bowl. \"Can we keep it?\" Lina asked. Her mother smiled. \"First, we must ask the neighbors.\"",
        "Nobody came for the kitten. After three days, it became part of the family. Lina named it Uci. Now Uci sleeps at the foot of her bed every night."
      ],
      "gloss": {
        "wet": "basah",
        "heard": "mendengar",
        "picked it up": "mengambilnya",
        "towel": "handuk",
        "bowl": "mangkuk",
        "keep": "memelihara",
        "neighbors": "tetangga",
        "foot of her bed": "ujung tempat tidurnya"
      },
