  "articles": [
    {
      "id": "r20261105-a01",
      "title": "Kadek’s Surf Lesson",
      "level": "Dasar",
      "min": 2,
      "body": [
        "Kadek lives near a beach in Bali. Every day he watched the surfers on the big waves. He wanted to try, but he was afraid of the deep water.",
        "On his twelfth birthday, his uncle gave him a surfboard and a free lesson. His uncle is a surf teacher. \"First, you must learn to stand on the sand,\" he said. Kadek practiced standing on the board on the beach all morning.",
        "In the afternoon, they went into the small waves. Kadek fell many times, but he laughed and tried again. At the end of the day, he stood up on a real wave for three seconds. It was the best birthday ever."
      ],
      "gloss": {
        "beach": "pantai",
        "waves": "ombak",
        "afraid": "takut",
        "deep": "dalam",
        "surfboard": "papan selancar",
        "practiced": "berlatih",
        "fell": "jatuh",
        "seconds": "detik"
      },
      "qs": [
