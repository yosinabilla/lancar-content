  "articles": [
    {
      "id": "r20261119-a01",
      "title": "Raka and the Old Radio",
      "level": "Dasar",
      "min": 2,
      "body": [
        "Raka found an old radio in his grandfather's garage. It was brown and heavy, with two round buttons in front. \"Does it still work?\" he asked. Grandfather smiled. \"Let's find out.\"",
        "They cleaned the radio with a dry cloth and put in new batteries. Raka turned the first button slowly. At first there was only noise. Then, suddenly, music filled the garage - an old song from the 1970s.",
        "Grandfather began to dance, and Raka laughed. Now, every Sunday afternoon, they sit together in the garage and listen to old songs. The radio is old, but for Raka it is the best thing in the house."
      ],
      "gloss": {
        "found": "menemukan",
        "garage": "garasi",
        "buttons": "tombol",
        "dry cloth": "kain kering",
        "batteries": "baterai",
        "suddenly": "tiba-tiba",
        "filled": "memenuhi",
        "laughed": "tertawa"
      },
