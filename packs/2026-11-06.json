  "articles": [
    {
      "id": "r20261106-a01",
      "title": "The Broken Kite",
      "level": "Dasar",
      "min": 2,
      "body": [
        "Andi loved his red kite. His father made it for him from bamboo and old newspaper. Every afternoon, Andi flew it in the field behind his house.",
        "One windy day, the string broke. The kite flew far away and fell into a tall tree. Andi was very sad. His neighbor, old Mr. Salim, saw everything from his porch. He brought a long ladder and helped Andi take the kite down.",
        "The kite had a small tear. Mr. Salim showed Andi how to fix it with tape and a thin stick. \"Broken things can fly again,\" he said with a smile. The next afternoon, the red kite danced in the sky once more."
      ],
      "gloss": {
        "kite": "layang-layang",
        "bamboo": "bambu",
        "string": "tali",
        "broke": "putus",
        "porch": "teras",
        "ladder": "tangga",
        "tear": "sobekan",
        "fix": "memperbaiki"
      },
      "qs": [
        {
          "q": "Who made the red kite?",
          "opts": [
            "Andi’s neighbor",
            "Andi’s teacher",
            "Andi’s father"
          ],
          "a": 2
        },
        {
          "q": "Where did the kite fall?",
